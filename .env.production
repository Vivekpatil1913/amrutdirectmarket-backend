# Production config for https://stallbook.mahaamrut.org.in — safe to commit.
# Read only when NODE_ENV=production (see ecosystem.config.cjs).
# Secrets (PGPASSWORD, JWT_SECRET) go in .env.production.local on the server;
# that file is gitignored and overrides anything here.
NODE_ENV=production
PORT=4200

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=amrit_peth
PGPASSWORD=
PGDATABASE=amrit_peth_cms

# Auth — JWT_SECRET is left empty on purpose: the server refuses to start in
# production until .env.production.local sets it (>= 32 chars).
JWT_SECRET=
SESSION_HOURS=24

# Sign-in protection counts WRONG passwords only — a correct password is never
# counted or refused, however often or with however many accounts.
#   LOGIN_MAX_ATTEMPTS          per account, from one address, per window
#   LOGIN_IP_MAX_ATTEMPTS       per address, across all accounts, per window
#   LOGIN_ACCOUNT_MAX_ATTEMPTS  per account, all addresses, in a row (0 = off)
#   LOGIN_LOCK_MINUTES          the window, and how long a pause/lock lasts
LOGIN_MAX_ATTEMPTS=10
LOGIN_IP_MAX_ATTEMPTS=100
LOGIN_ACCOUNT_MAX_ATTEMPTS=50
LOGIN_LOCK_MINUTES=15

# Nginx on this host proxies /api, so the default TRUST_PROXY
# (loopback, linklocal, uniquelocal) reads the visitor's address from
# X-Forwarded-For. Nginx must send it:
#   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
# General API requests per 15 min (per signed-in account, otherwise per address)
API_RATE_LIMIT=1000

# Website and admin panel (/admin) are served from the same origin
CORS_ORIGINS=https://stallbook.mahaamrut.org.in,https://bajarpeth.mahaamrut.org.in

# Uploads (relative to the backend folder, or absolute)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# First super admin, created by `npm run db:seed:prod` only when no admin exists.
# Password empty = one is generated and printed once; change it after login.
SEED_ADMIN_EMAIL=admin@mahaamrut.org.in
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Super Admin

LOG_LEVEL=info
LOG_REQUESTS=true

