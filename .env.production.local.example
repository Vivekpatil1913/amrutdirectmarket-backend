# Copy to .env.production.local ON THE SERVER ONLY (never commit it).
# Generate a secret with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PGPASSWORD=put_the_postgres_password_here
JWT_SECRET=put_a_random_string_of_at_least_32_characters_here
# 64 hex chars, generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it safe: Aadhaar numbers already stored cannot be decrypted without it.
AADHAAR_ENC_KEY=put_64_hex_characters_here
