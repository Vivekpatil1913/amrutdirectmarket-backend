NODE_ENV=development
PORT=4200

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=change_me
PGDATABASE=amrit_peth_cms

# Auth — use a long random value (>= 32 chars) in production
JWT_SECRET=replace_with_a_long_random_secret
SESSION_HOURS=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Browser origins allowed to call the API (website + admin), comma-separated
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Uploads (relative to the backend folder, or absolute)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# First super admin, created by `npm run db:seed` only when no admin exists.
# Leave the password empty to have one generated and printed once.
SEED_ADMIN_EMAIL=admin@amritpeth.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Super Admin

# info | warn | error | debug ; LOG_REQUESTS logs one line per request
LOG_LEVEL=info
LOG_REQUESTS=true

# Thet Bajar Peth — Aadhaar encryption key (64 hex chars; required in production).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AADHAAR_ENC_KEY=
# OTP for applicant phone verification. OTP_DEV_ECHO returns the code in the
# API response while no SMS gateway is configured (development only).
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_VERIFIED_MINUTES=30
OTP_DEV_ECHO=true
